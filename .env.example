# TCBS iFlash Open API Configuration
TCBS_API_KEY=your_tcbs_api_key_here
TCBS_BASE_URL=https://openapi.tcbs.com.vn

# Database Connection (shared PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:123@db:5432/markovlotteai

# Redis Configuration (shared Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# Discord Bot Credentials (for Human-in-the-Loop alerts and actions)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
DISCORD_ENABLED=true

# Trading parameters
TRADING_MODE=paper
MAX_CONCURRENT_BOTS=10
DEFAULT_STOP_LOSS_PCT=5.0
DEFAULT_TAKE_PROFIT_PCT=10.0
DEFAULT_MAX_DRAWDOWN_PCT=15.0

# JWT Auto-Refresh Setting
JWT_REFRESH_BUFFER_MIN=5

# Logging level
LOG_LEVEL=INFO
